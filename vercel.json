{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/(.*)", "dest": "public/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 14 * * *"
    }
  ]
}
